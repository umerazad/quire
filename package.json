{
  "name": "quire-native-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:vendor": "bun tools/verify-vendor.ts",
    "dev": "bun tools/run.ts",
    "test:reference": "node node_modules/vitest/vitest.mjs run tests/reference",
    "test:storage-crash": "node tools/test-storage-crash.ts",
    "test:vim-search": "cargo test -p vim --locked --features util/debug-embed --lib normal::search::test::",
    "test:vim-command": "cargo test -p vim --locked --features util/debug-embed --lib command::test:: -- --test-threads=1",
    "test:vim-mark": "cargo test -p vim --locked --features util/debug-embed --lib normal::mark::test::"
  },
  "devDependencies": {
    "@lezer/common": "1.5.4",
    "@lezer/markdown": "1.8.1",
    "vitest": "5.0.5"
  }
}
