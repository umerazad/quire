    "second": "- one!\n- two\n",
    "text": "- zero\n- one!\n- two\n",
    "overlaps": 0
  },
  {
    "name": "a line changed below a line the other side added: both apply",
    "base": "- one\n- two\n",
    "first": "- one!\n- two\n",
    "second": "- zero\n- one\n- two\n",
    "text": "- zero\n- one!\n- two\n",
    "overlaps": 0
  },
  {
    "name": "words added before a word the other side changed merge",
    "base": "- call Sam\n",
    "first": "- [ ] call Sam\n",
    "second": "- email Sam\n",
    "text": "- [ ] email Sam\n",
    "overlaps": 0
  },
  {
    "name": "a line added above a line the other side removed: the addition stays",
    "base": "- one\n- two\n",
    "first": "- zero\n- one\n- two\n",
    "second": "- two\n",
    "text": "- zero\n- two\n",
    "overlaps": 0
