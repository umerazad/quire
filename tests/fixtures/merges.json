  },
  {
    "name": "both sides typed into an empty bullet",
    "base": "- one\n- \n",
    "first": "- one\n- first words\n",
    "second": "- one\n- second words\n",
    "text": "- one\n- first words\n- second words\n",
    "overlaps": 1
  },
  {
