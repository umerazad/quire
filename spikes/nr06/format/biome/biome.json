{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": { "parser": { "allowComments": true, "allowTrailingCommas": true } },
  "html": { "formatter": { "enabled": true } },
  "css": { "formatter": { "enabled": true } }
}
